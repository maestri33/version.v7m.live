---
import '../styles/global.css';
import { getAllVersionEntries, getPlatformLatestVersion } from '../lib/versions';
import { render } from 'astro:content';

const platform = await getPlatformLatestVersion();
const entries = await getAllVersionEntries();

const renderedEntries = await Promise.all(
  entries.map(async (entry) => {
    const { Content } = await render(entry);
    return {
      entry,
      Content,
    };
  })
);

const moduleList = Object.entries(platform.apps);

const typeColors: Record<string, { bg: string; text: string; border: string }> = {
  patch: { bg: 'bg-[var(--blue-deep)]/60', text: 'text-[var(--muted-on-dark)]', border: 'border-[var(--blue)]/50' },
  minor: { bg: 'bg-[var(--green-deep)]/60', text: 'text-emerald-300', border: 'border-[var(--green)]/50' },
  major: { bg: 'bg-[var(--yellow)]/15', text: 'text-[var(--yellow)]', border: 'border-[var(--yellow)]/40' },
};
---

<!doctype html>
<html lang="pt-BR" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Central de Versionamento | Supletivo Brasil</title>
    <meta
      name="description"
      content="Oráculo central e fonte única da verdade sobre a versão da Plataforma Supletivo Brasil."
    />
  </head>
  <body class="min-h-screen bg-[var(--ink)] text-[var(--paper)] font-sans antialiased">
    <header class="border-b border-white/10 bg-[var(--ink)]/85 backdrop-blur-md sticky top-0 z-50">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="h-9 w-9 rounded-lg bg-[var(--blue)] border border-white/15 flex items-center justify-center font-display text-base text-[var(--yellow)] shadow-lg shadow-black/40">
            V
          </div>
          <div>
            <div class="text-sm font-bold tracking-tight text-[var(--paper)]">version.v7m.live</div>
            <div class="text-xs text-[var(--muted-on-dark)]">Supletivo Brasil — Oráculo da Plataforma</div>
          </div>
        </div>

        <div class="flex items-center gap-2 sm:gap-3">
          <a
            href="/api/version/history"
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs font-mono px-3 py-1.5 rounded-lg bg-[var(--ink-soft)] hover:bg-white/10 text-[var(--muted-on-dark)] hover:text-[var(--paper)] border border-white/10 transition"
          >
            /api/version/history
          </a>
          <a
            href="/api/version"
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs font-mono font-bold px-3 py-1.5 rounded-lg bg-[var(--yellow)] hover:bg-[var(--yellow-soft)] text-[var(--ink)] border border-[var(--yellow-soft)] transition flex items-center gap-1.5 shadow-sm"
          >
            <span class="w-2 h-2 rounded-full bg-[var(--green)] animate-pulse"></span>
            <span>GET /api/version</span>
          </a>
        </div>
      </div>
    </header>

    <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-12">
      <section class="rounded-[var(--radius-lg)] glass-panel shadow-zero-g p-6 sm:p-10 relative overflow-hidden">
        <div class="absolute -top-28 -right-28 w-96 h-96 bg-[var(--blue)]/30 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-24 -left-24 w-80 h-80 bg-[var(--green)]/20 rounded-full blur-3xl pointer-events-none"></div>

        <div class="relative z-10 max-w-3xl">
          <div class="flex flex-wrap items-center gap-2 mb-4">
            <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-medium bg-[var(--green-deep)]/80 text-emerald-200 border border-[var(--green)]/50">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping"></span>
              <span>Oráculo Ativo • Versão Única</span>
            </span>
            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-[var(--ink-soft)] text-[var(--muted-on-dark)] border border-white/10">
              Cloudflare Workers SSR
            </span>
          </div>

          <div class="flex flex-wrap items-baseline gap-3">
            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-display tracking-tight text-[var(--paper)]">
              v{platform.version}
            </h1>
            <span class="text-[var(--muted-on-dark)] text-lg sm:text-xl font-medium">
              — Plataforma Supletivo Brasil
            </span>
          </div>

          <p class="mt-4 text-[var(--muted-on-dark)] text-sm sm:text-base leading-relaxed">
            Fonte única da verdade e oráculo central para o versionamento do ecossistema Supletivo Brasil.
            Toda entrega homologada em qualquer módulo do ecossistema consolida o Release Train e incrementa a versão global da plataforma.
          </p>

          <div class="mt-8 grid grid-cols-1 sm:grid-cols-3 gap-4 border-t border-white/10 pt-5 text-xs">
            <div class="bg-[var(--ink-soft)]/90 rounded-[var(--radius)] p-3.5 border border-white/10">
              <span class="text-[var(--muted-on-dark)] block text-xs">Último Módulo Atualizado:</span>
              <strong class="text-[var(--yellow)] font-mono text-sm block mt-1">{platform.last_module_updated}</strong>
            </div>
            <div class="bg-[var(--ink-soft)]/90 rounded-[var(--radius)] p-3.5 border border-white/10">
              <span class="text-[var(--muted-on-dark)] block text-xs">Data da Entrega:</span>
              <strong class="text-[var(--paper)] block mt-1 font-mono">
                {new Date(platform.updated_at).toLocaleDateString('pt-BR', { timeZone: 'UTC' })} (#{platform.commit})
              </strong>
            </div>
            <div class="bg-[var(--ink-soft)]/90 rounded-[var(--radius)] p-3.5 border border-white/10">
              <span class="text-[var(--muted-on-dark)] block text-xs">Autorizado por:</span>
              <strong class="text-[var(--paper)] block mt-1">{platform.authorized_by}</strong>
            </div>
          </div>
        </div>
      </section>

      <section class="space-y-4">
        <div class="flex items-center justify-between">
          <h2 class="text-xl sm:text-2xl font-display tracking-tight text-[var(--paper)] flex items-center gap-2.5">
            <span>Módulos do Ecossistema</span>
            <span class="text-xs font-sans font-semibold text-[var(--muted-on-dark)] px-2.5 py-0.5 rounded-full bg-[var(--ink-soft)] border border-white/10">
              {moduleList.length}
            </span>
          </h2>
          <span class="text-xs text-[var(--muted-on-dark)]">
            Versão da última alteração de cada aplicação
          </span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          {moduleList.map(([modName, latestVer]) => {
            const modEntries = entries.filter((e) => e.data.module === modName);
            const latestEntry = modEntries[0];
            return (
              <div class="rounded-[var(--radius)] glass-panel hover:border-white/20 p-5 transition flex flex-col justify-between group shadow-lg">
                <div>
                  <div class="flex items-start justify-between gap-2">
                    <h3 class="font-mono text-sm font-bold text-[var(--paper)] group-hover:text-[var(--yellow)] transition break-all">
                      {modName}
                    </h3>
                    <span class="font-mono text-xs font-bold px-2 py-0.5 rounded bg-[var(--blue-deep)] text-[var(--yellow)] border border-[var(--blue)] shrink-0">
                      v{latestVer}
                    </span>
                  </div>

                  {latestEntry && (
                    <p class="text-xs text-[var(--muted-on-dark)] mt-3 line-clamp-2">
                      {latestEntry.data.summary}
                    </p>
                  )}
                </div>

                <div class="mt-4 pt-3 border-t border-white/10 flex items-center justify-between text-xs">
                  <span class="text-[var(--muted-on-dark)]">Última ação: <strong class="text-[var(--paper)] font-mono">{latestEntry?.data.date ?? 'N/A'}</strong></span>
                  <a
                    href={`/api/version/${modName}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-mono text-[var(--yellow)] hover:underline flex items-center gap-1"
                  >
                    <span>histórico</span>
                    <span>→</span>
                  </a>
                </div>
              </div>
            );
          })}
        </div>
      </section>

      <section class="space-y-6">
        <div>
          <h2 class="text-xl sm:text-2xl font-display tracking-tight text-[var(--paper)]">
            Linha do Tempo da Plataforma (Release Train)
          </h2>
          <p class="text-xs text-[var(--muted-on-dark)] mt-1">
            Cada incremento reflete a consolidação global do ecossistema Supletivo Brasil.
          </p>
        </div>

        <div class="space-y-4">
          {renderedEntries.map(({ entry, Content }) => {
            const data = entry.data;
            const style = typeColors[data.type] || typeColors.patch;

            return (
              <article class="rounded-[var(--radius)] glass-panel p-5 sm:p-6 transition space-y-4 shadow-lg hover:border-white/25">
                <div class="flex flex-wrap items-center justify-between gap-3 border-b border-white/10 pb-3">
                  <div class="flex flex-wrap items-center gap-2">
                    <span class="font-display text-sm tracking-wide px-3 py-1 rounded-md bg-[var(--blue-deep)] text-[var(--yellow)] border border-[var(--blue)]">
                      v{data.version}
                    </span>
                    <span class="font-mono text-xs px-2 py-0.5 rounded bg-[var(--ink-soft)] text-[var(--paper)] border border-white/10">
                      {data.module}
                    </span>
                    <span class={`text-[10px] uppercase tracking-wider font-bold px-2 py-0.5 rounded border ${style.bg} ${style.text} ${style.border}`}>
                      {data.type}
                    </span>
                  </div>

                  <div class="flex items-center gap-3 text-xs text-[var(--muted-on-dark)] font-mono">
                    <span>{data.date}</span>
                    <span>•</span>
                    <span title="Commit Hash" class="bg-[var(--ink-soft)] px-2 py-0.5 rounded text-[var(--paper)] border border-white/10">
                      #{data.commit}
                    </span>
                  </div>
                </div>

                <div>
                  <h3 class="text-base font-semibold text-[var(--paper)]">
                    {data.summary}
                  </h3>
                  <div class="mt-1 text-xs text-[var(--muted-on-dark)]">
                    Autorizado por: <strong class="text-[var(--paper)]">{data.authorized_by}</strong>
                  </div>
                </div>

                <div class="prose prose-invert prose-sm max-w-none text-[var(--muted-on-dark)] text-sm pt-2 border-t border-white/5 leading-relaxed">
                  <Content />
                </div>
              </article>
            );
          })}
        </div>
      </section>
    </main>

    <footer class="mt-20 border-t border-white/10 py-8 text-center text-xs text-[var(--muted-on-dark)]">
      <div class="max-w-6xl mx-auto px-4 space-y-2">
        <p>
          <strong class="text-[var(--paper)]">Supletivo Brasil</strong> • Oráculo Central de Versionamento (<code class="text-[var(--yellow)]">version.v7m.live</code>)
        </p>
        <p>Versão Única da Plataforma • Cloudflare Edge SSR</p>
      </div>
    </footer>
  </body>
</html>
