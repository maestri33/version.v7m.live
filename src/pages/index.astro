---
import '../styles/global.css';
import { getAllVersionEntries, getPlatformLatestVersion } from '../lib/versions';
import { render } from 'astro:content';

export const prerender = false;

const platform = await getPlatformLatestVersion();
const entries = await getAllVersionEntries();

// Pre-render markdown content for each release entry
const renderedEntries = await Promise.all(
  entries.map(async (entry) => {
    const { Content } = await render(entry);
    return {
      entry,
      Content,
    };
  })
);

const moduleList = Object.entries(platform.apps);

const typeColors: Record<string, string> = {
  patch: 'bg-blue-500/10 text-blue-400 border-blue-500/20',
  minor: 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20',
  major: 'bg-purple-500/10 text-purple-400 border-purple-500/20',
};
---

<!doctype html>
<html lang="pt-BR" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Central de Versionamento | Supletivo Brasil</title>
    <meta
      name="description"
      content="Oráculo central e fonte única da verdade sobre a versão da Plataforma Supletivo Brasil."
    />
  </head>
  <body class="min-h-screen bg-slate-950 text-slate-100 antialiased selection:bg-cyan-500 selection:text-white">
    <!-- Top Navigation / Header -->
    <header class="border-b border-slate-800/80 bg-slate-950/90 backdrop-blur-md sticky top-0 z-50">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="h-9 w-9 rounded-lg bg-gradient-to-tr from-cyan-600 to-blue-500 flex items-center justify-center font-bold text-white shadow-lg shadow-cyan-500/20">
            V
          </div>
          <div>
            <div class="text-sm font-semibold leading-none tracking-tight text-white">version.v7m.live</div>
            <div class="text-xs text-slate-400 mt-1">Supletivo Brasil — Oráculo de Versão</div>
          </div>
        </div>

        <div class="flex items-center gap-2 sm:gap-3">
          <a
            href="/api/version/history"
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs font-mono px-3 py-1.5 rounded-md bg-slate-900 hover:bg-slate-800 text-slate-400 hover:text-slate-200 border border-slate-800 transition"
          >
            /api/version/history
          </a>
          <a
            href="/api/version"
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs font-mono px-3 py-1.5 rounded-md bg-cyan-950/80 hover:bg-cyan-900/80 text-cyan-300 border border-cyan-800/80 transition flex items-center gap-1.5 shadow-sm"
          >
            <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
            <span>GET /api/version</span>
          </a>
        </div>
      </div>
    </header>

    <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-10">
      <!-- Intro Hero Banner: Single Platform Version -->
      <section class="rounded-2xl bg-gradient-to-b from-slate-900 via-slate-900/90 to-slate-950 border border-slate-800 p-6 sm:p-8 relative overflow-hidden shadow-2xl">
        <div class="absolute -top-24 -right-24 w-80 h-80 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>
        <div class="relative z-10 max-w-3xl">
          <div class="flex flex-wrap items-center gap-2 mb-4">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium bg-cyan-950/70 text-cyan-300 border border-cyan-800/60">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping"></span>
              <span>Versão Única da Plataforma</span>
            </span>
            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-slate-800/80 text-slate-300 border border-slate-700">
              Cloudflare Edge SSR
            </span>
          </div>

          <div class="flex flex-wrap items-baseline gap-3">
            <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white font-mono">
              v{platform.version}
            </h2>
            <span class="text-slate-400 text-base sm:text-lg font-normal">
              — Plataforma Supletivo Brasil
            </span>
          </div>

          <p class="mt-3 text-slate-400 text-sm sm:text-base leading-relaxed">
            Oráculo central e fonte única da verdade para a versão e o histórico de entregas do ecossistema.
            Qualquer alteração homologada em qualquer módulo incrementa a versão global da plataforma.
          </p>

          <div class="mt-6 grid grid-cols-1 sm:grid-cols-3 gap-4 border-t border-slate-800/80 pt-4 text-xs">
            <div class="bg-slate-950/40 rounded-lg p-3 border border-slate-800/50">
              <span class="text-slate-500 block">Último Módulo Atualizado:</span>
              <strong class="text-cyan-300 font-mono text-sm block mt-0.5">{platform.last_module_updated}</strong>
            </div>
            <div class="bg-slate-950/40 rounded-lg p-3 border border-slate-800/50">
              <span class="text-slate-500 block">Última Entrega:</span>
              <strong class="text-slate-200 block mt-0.5 font-mono">
                {new Date(platform.updated_at).toLocaleDateString('pt-BR', { timeZone: 'UTC' })} (#{platform.commit})
              </strong>
            </div>
            <div class="bg-slate-950/40 rounded-lg p-3 border border-slate-800/50">
              <span class="text-slate-500 block">Autorizado por:</span>
              <strong class="text-slate-200 block mt-0.5">{platform.authorized_by}</strong>
            </div>
          </div>
        </div>
      </section>

      <!-- Modules in Platform -->
      <section class="space-y-4">
        <div class="flex items-center justify-between">
          <h3 class="text-lg font-semibold tracking-tight text-white flex items-center gap-2">
            <span>Módulos do Ecossistema</span>
            <span class="text-xs font-normal text-slate-400 px-2 py-0.5 rounded-full bg-slate-800 border border-slate-700">
              {moduleList.length}
            </span>
          </h3>
          <span class="text-xs text-slate-400">
            Versão da última alteração de cada módulo
          </span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          {moduleList.map(([modName, latestVer]) => {
            const modEntries = entries.filter((e) => e.data.module === modName);
            const latestEntry = modEntries[0];
            return (
              <div class="rounded-xl bg-slate-900/80 border border-slate-800 hover:border-slate-700 p-5 transition flex flex-col justify-between group">
                <div>
                  <div class="flex items-start justify-between gap-2">
                    <h4 class="font-mono text-sm font-medium text-slate-100 group-hover:text-cyan-400 transition break-all">
                      {modName}
                    </h4>
                    <span class="font-mono text-xs font-semibold px-2 py-0.5 rounded bg-slate-800 text-cyan-300 border border-slate-700 shrink-0">
                      v{latestVer}
                    </span>
                  </div>

                  {latestEntry && (
                    <p class="text-xs text-slate-400 mt-3 line-clamp-2">
                      {latestEntry.data.summary}
                    </p>
                  )}
                </div>

                <div class="mt-4 pt-3 border-t border-slate-800/60 flex items-center justify-between text-xs">
                  <span class="text-slate-500">Última ação: <strong class="text-slate-300 font-mono">{latestEntry?.data.date ?? 'N/A'}</strong></span>
                  <a
                    href={`/api/version/${modName}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-mono text-cyan-400 hover:text-cyan-300 hover:underline"
                  >
                    histórico →
                  </a>
                </div>
              </div>
            );
          })}
        </div>
      </section>

      <!-- Chronological Platform Release Train -->
      <section class="space-y-6">
        <div>
          <h3 class="text-lg font-semibold tracking-tight text-white">
            Linha do Tempo da Plataforma (Release Train)
          </h3>
          <p class="text-xs text-slate-400 mt-1">
            Cada incremento de versão consolida o estado global da Plataforma Supletivo Brasil.
          </p>
        </div>

        <div class="space-y-4">
          {renderedEntries.map(({ entry, Content }) => {
            const data = entry.data;
            const badgeStyle = typeColors[data.type] || typeColors.patch;

            return (
              <article class="rounded-xl bg-slate-900/60 border border-slate-800 hover:border-slate-700/80 p-5 sm:p-6 transition space-y-4">
                <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-800/60 pb-3">
                  <div class="flex flex-wrap items-center gap-2">
                    <span class="font-mono text-sm font-bold px-2.5 py-1 rounded-md bg-cyan-950 text-cyan-300 border border-cyan-800">
                      v{data.version}
                    </span>
                    <span class="font-mono text-xs px-2 py-0.5 rounded bg-slate-800 text-slate-200 border border-slate-700">
                      {data.module}
                    </span>
                    <span class={`text-[10px] uppercase tracking-wider font-semibold px-2 py-0.5 rounded border ${badgeStyle}`}>
                      {data.type}
                    </span>
                  </div>

                  <div class="flex items-center gap-3 text-xs text-slate-400 font-mono">
                    <span>{data.date}</span>
                    <span>•</span>
                    <span title="Commit Hash" class="bg-slate-800 px-2 py-0.5 rounded text-slate-300">
                      #{data.commit}
                    </span>
                  </div>
                </div>

                <div>
                  <h4 class="text-base font-medium text-slate-100">
                    {data.summary}
                  </h4>
                  <div class="mt-1 text-xs text-slate-400">
                    Autorizado por: <strong class="text-slate-300">{data.authorized_by}</strong>
                  </div>
                </div>

                <!-- Markdown Content rendered -->
                <div class="prose prose-invert prose-sm max-w-none text-slate-300 text-sm pt-2 border-t border-slate-800/40">
                  <Content />
                </div>
              </article>
            );
          })}
        </div>
      </section>
    </main>

    <!-- Footer -->
    <footer class="mt-20 border-t border-slate-800/80 py-8 text-center text-xs text-slate-500">
      <div class="max-w-6xl mx-auto px-4 space-y-2">
        <p>
          <strong class="text-slate-400">Supletivo Brasil</strong> • Oráculo Central de Versionamento (<code class="text-slate-400">version.v7m.live</code>)
        </p>
        <p>Versão Única da Plataforma • Cloudflare Edge SSR</p>
      </div>
    </footer>
  </body>
</html>
